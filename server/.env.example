# PostgreSQL database connection URL (e.g. postgresql://user:password@localhost:5432/dbname)
DATABASE_URL="postgresql://postgres:password@localhost:5432/securehire?schema=public"

# Secret key for JWT generation & verification
JWT_SECRET="generate_a_secure_random_string_for_production"

# Allowed client origin (CORS)
CLIENT_URL="http://localhost:5173"

# Port on which the Express server will listen
PORT=5000
